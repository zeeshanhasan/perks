// Tofo Perks data model. SQLite locally, Cloudflare D1 in production (decision 001).
// Every app table is scoped by `shop` (the myshopify domain).
// JSON lists are stored as strings (portable across SQLite/D1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local dev: DATABASE_URL="file:./dev.sqlite" in .env. Railway: file:/data/perks.sqlite (volume).
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// LEGACY (v1, single employer). Migrated into Business on first load; kept for rollback.
model Employer {
  shop      String   @id
  name      String   @default("")
  /// JSON array of lowercase domains, e.g. ["tofoapp.com"]
  domains   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BenefitPolicy {
  shop                 String   @id
  discountPercent      Int      @default(10)
  /// null = no expiry
  eligibilityMonths    Int?     @default(12)
  /// "selected" (employee-only + discounted list) | "all_products". Legacy "employee_only" = "selected".
  discountScope        String   @default("selected")
  /// Logged-in customers whose account email is at an approved domain are eligible automatically.
  autoDomain           Boolean  @default(true)
  combinesWithProduct  Boolean  @default(false)
  combinesWithOrder    Boolean  @default(false)
  combinesWithShipping Boolean  @default(false)
  /// JSON arrays of product GIDs
  employeeOnlyProducts String   @default("[]")
  excludedProducts     String   @default("[]")
  /// Open to everyone; employees get the discount on these.
  discountedProducts   String   @default("[]")
  /// Handles of employee-only products, for the storefront embed (hiding product cards).
  employeeOnlyHandles  String   @default("[]")
  /// Shopify object GIDs created by the app
  discountId           String?
  validationId         String?
  enabled              Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model EmployeeMembership {
  id          String    @id @default(cuid())
  shop        String
  /// Numeric Shopify customer ID (from the signed app proxy request)
  customerId  String
  /// Business the employee belongs to (null = legacy single-employer row)
  businessId  String?
  /// Private. Never written to Shopify, never logged. For source=domain it's the account email.
  workEmail   String
  /// "link" (verified via emailed link) | "domain" (account email at approved domain)
  source      String    @default("link")
  /// "active" | "revoked" | "expired" | "inactive" (domain no longer approved)
  status      String
  verifiedAt  DateTime
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shop, customerId])
  @@index([shop, status])
}

model VerificationChallenge {
  id         String    @id @default(cuid())
  shop       String
  customerId String
  workEmail  String
  /// SHA-256 hex of the raw token. The raw token is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([shop, customerId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  shop      String
  /// "customer:<id>" | "merchant:<user id or 'admin'>" | "system"
  actor     String
  action    String
  subject   String?
  result    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

/// Sliding-window rate limit hits.
model RateLimitHit {
  id        String   @id @default(cuid())
  shop      String
  key       String
  createdAt DateTime @default(now())

  @@index([shop, key, createdAt])
}

/// A partner company whose employees get perks. Many per shop.
model Business {
  id                 String   @id @default(cuid())
  shop               String
  name               String
  /// JSON array of lowercase domains
  domains            String   @default("[]")
  /// "percentage" | "fixed" (fixed = amount off each eligible item, shop currency)
  discountType       String   @default("percentage")
  discountValue      Float    @default(10)
  /// Targeting JSON: { all, products:[{id,title}], collections:[{id,title}], vendors:[], types:[] }
  discountTarget     String   @default("{}")
  employeeOnlyTarget String   @default("{}")
  /// "none" | "month" | "year"
  limitPeriod        String   @default("none")
  /// "discount" (cap on discount received) | "spend" (cap on employee spend)
  limitBasis         String   @default("discount")
  limitAmount        Float?
  billingEmail       String   @default("")
  billingAddress     String   @default("")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
}

/// One row per employee order (recorded from the orders/create webhook).
model OrderUsage {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  orderName   String
  customerId  String
  businessId  String
  processedAt DateTime
  currency    String
  /// Subtotal after discounts (what the employee paid for goods)
  spend       Float
  /// Order total incl. shipping and tax
  total       Float
  /// Employee discount received on this order
  discount    Float
  cancelled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, businessId, processedAt])
  @@index([shop, customerId, processedAt])
}

model Invoice {
  id          String   @id @default(cuid())
  shop        String
  businessId  String
  number      String
  periodStart DateTime
  /// Exclusive end
  periodEnd   DateTime
  /// "discount" | "spend"
  basis       String
  amount      Float
  orderCount  Int
  currency    String
  /// Frozen snapshot of billed orders (JSON), so later cancellations don't change an issued invoice
  lines       String   @default("[]")
  businessName String  @default("")
  createdAt   DateTime @default(now())

  @@unique([shop, number])
  @@index([shop, businessId])
}

