// Tofo Perks data model. SQLite locally, Cloudflare D1 in production (decision 001).
// Every app table is scoped by `shop` (the myshopify domain).
// JSON lists are stored as strings (portable across SQLite/D1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local dev: DATABASE_URL="file:./dev.sqlite" in .env. Railway: file:/data/perks.sqlite (volume).
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// LEGACY (v1, single employer). Migrated into Business on first load; kept for rollback.
model Employer {
  shop      String   @id
  name      String   @default("")
  /// JSON array of lowercase domains, e.g. ["tofoapp.com"]
  domains   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BenefitPolicy {
  shop                 String   @id
  discountPercent      Int      @default(10)
  /// null = no expiry
  eligibilityMonths    Int?     @default(12)
  /// "selected" (employee-only + discounted list) | "all_products". Legacy "employee_only" = "selected".
  discountScope        String   @default("selected")
  /// Logged-in customers whose account email is at an approved domain are eligible automatically.
  autoDomain           Boolean  @default(true)
  combinesWithProduct  Boolean  @default(false)
  combinesWithOrder    Boolean  @default(false)
  combinesWithShipping Boolean  @default(false)
  /// JSON arrays of product GIDs
  employeeOnlyProducts String   @default("[]")
  excludedProducts     String   @default("[]")
  /// Open to everyone; employees get the discount on these.
  discountedProducts   String   @default("[]")
  /// Handles of employee-only products, for the storefront embed (hiding product cards).
  employeeOnlyHandles  String   @default("[]")
  /// Shopify object GIDs created by the app
  discountId           String?
  validationId         String?
  enabled              Boolean  @default(false)
  /// Storefront (Employee mode) options and texts, JSON. See app/lib/storefront.ts.
  storefront           String   @default("{}")
  /// Billing (decision 017): plan handle last seen, the Shopify plan when the store first subscribed
  /// (Basic stores that upgrade keep the Basic price), and when perks were paused for having no plan.
  planHandle           String?
  planShopifyAtStart   String?
  billingPausedAt      DateTime?
  /// Last products/create|update|delete webhook, and the last sync that ran after one. The scheduler re-syncs
  /// (once things are quiet) so the storefront's product lists include imported or edited products.
  productsChangedAt    DateTime?
  productsSyncedAt     DateTime?
  updatedAt            DateTime @updatedAt
}

model EmployeeMembership {
  id          String    @id @default(cuid())
  shop        String
  /// Numeric Shopify customer ID (from the signed app proxy request)
  customerId  String
  /// Business the employee belongs to (null = legacy single-employer row)
  businessId  String?
  /// Private. Never written to Shopify, never logged. For source=domain it's the account email.
  workEmail   String
  /// "link" (verified via emailed link) | "domain" (account email at approved domain)
  source      String    @default("link")
  /// "active" | "revoked" | "expired" | "inactive" (domain no longer approved)
  status      String
  verifiedAt  DateTime
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shop, customerId])
  @@index([shop, status])
}

model VerificationChallenge {
  id         String    @id @default(cuid())
  shop       String
  customerId String
  workEmail  String
  /// SHA-256 hex of the raw token. The raw token is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([shop, customerId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  shop      String
  /// "customer:<id>" | "merchant:<user id or 'admin'>" | "system"
  actor     String
  action    String
  subject   String?
  result    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

/// Sliding-window rate limit hits.
model RateLimitHit {
  id        String   @id @default(cuid())
  shop      String
  key       String
  createdAt DateTime @default(now())

  @@index([shop, key, createdAt])
}

/// A partner company whose employees get perks. Many per shop.
model Business {
  id                 String   @id @default(cuid())
  shop               String
  name               String
  /// JSON array of lowercase domains
  domains            String   @default("[]")
  /// "percentage" | "fixed" (fixed = amount off each eligible item, shop currency)
  discountType       String   @default("percentage")
  discountValue      Float    @default(10)
  /// Targeting JSON: { all, products:[{id,title}], collections:[{id,title}], vendors:[], types:[] }
  discountTarget     String   @default("{}")
  employeeOnlyTarget String   @default("{}")
  /// "none" | "month" | "year"
  limitPeriod        String   @default("none")
  /// "discount" (cap on discount received) | "spend" (cap on employee spend)
  limitBasis         String   @default("discount")
  limitAmount        Float?
  /// What an order that goes past the limit gets: "partial" (what's left of the limit) | "whole" (only items that fit in full)
  limitOverflow      String   @default("partial")
  billingEmail       String   @default("")
  billingAddress     String   @default("")
  /// What its monthly invoice bills: "discount" (employee discount given) | "spend" (what employees paid)
  billFor            String   @default("discount")
  active             Boolean  @default(true)
  /// Set when deleted. Kept so reports and invoices still show the name.
  archivedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
}

/// One row per employee order (recorded from the orders/create webhook).
model OrderUsage {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  orderName   String
  customerId  String
  businessId  String
  processedAt DateTime
  currency    String
  /// Subtotal after discounts (what the employee paid for goods)
  spend       Float
  /// Order total incl. shipping and tax
  total       Float
  /// Employee discount received on this order
  discount    Float
  cancelled   Boolean  @default(false)
  /// Shopify fulfilment: "unfulfilled" | "partial" | "fulfilled" | "unknown" (recorded before this was tracked; looked up on the Reports page)
  fulfillment String   @default("unknown")
  /// Line items as JSON (OrderItem[] in lib/usage.ts), for itemised invoices. "[]" for orders recorded before this existed.
  items       String   @default("[]")
  /// The customer's email on the order (fallback for the employee email on invoices)
  email       String   @default("")
  createdAt   DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, businessId, processedAt])
  @@index([shop, customerId, processedAt])
}

/// One invoice per business per month (decision 018). Only the number is stored: amounts are worked out live
/// from OrderUsage, so cancelled orders drop out and fulfilled ones become due.
model Invoice {
  id           String   @id @default(cuid())
  shop         String
  businessId   String
  /// "2026-11"
  month        String
  /// INV-202611-001 (numbered in the order businesses first have orders that month)
  number       String
  businessName String   @default("")
  createdAt    DateTime @default(now())

  @@unique([shop, number])
  @@unique([shop, businessId, month])
}


/// Shopify facts we'd otherwise ask Shopify for on every page (decision 017 follow-up, speed):
/// store details (refreshed every 6 h) and the app subscription (refreshed every hour).
model ShopCache {
  shop        String    @id
  shopGid     String
  name        String    @default("")
  currency    String    @default("")
  timezone    String    @default("UTC")
  shopifyPlan String    @default("")
  infoAt      DateTime
  /// JSON of the live subscription (see billing.server.ts); null = not checked yet.
  billing     String?
  billingAt   DateTime?
}
