# Required. Local SQLite file (relative to prisma/).
DATABASE_URL="file:./dev.sqlite"

# Copy to .env (gitignored). Shopify CLI provides SHOPIFY_API_KEY/SECRET/APP_URL during `shopify app dev`.

# Billing (decision 017). Leave empty and billing stays off (no plan page).
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
# Optional: app handle for the plan page URL (default tofo-perks), Basic plan handle (default basic)
SHOPIFY_APP_HANDLE=
PLAN_HANDLE_BASIC=
# Shops that never pay, comma separated
BILLING_EXEMPT_SHOPS=

# Protects POST /api/cron/expire (generate with: openssl rand -hex 32)
CRON_SECRET=
