# Required. Local SQLite file (relative to prisma/).
DATABASE_URL="file:./dev.sqlite"

# Copy to .env (gitignored). Shopify CLI provides SHOPIFY_API_KEY/SECRET/APP_URL during `shopify app dev`.

# Optional in dev: without it, verification links print to the terminal.
RESEND_API_KEY=
PERKS_EMAIL_FROM="Tofo Perks <perks@mail.tofoapp.com>"

# Protects POST /api/cron/expire (generate with: openssl rand -hex 32)
CRON_SECRET=
