{%- comment -%}
  Product page badge for employee-only products. Cosmetic only:
  enforcement happens at checkout (perks-validation Function).
{%- endcomment -%}
{%- assign p = product | default: block.settings.product -%}
{%- if p and p.metafields.app.perks_employee_only.value == true -%}
  <div class="perks-badge" style="border:1px solid {{ block.settings.accent }}; padding:12px; border-radius:6px; margin:12px 0;">
    <strong style="color: {{ block.settings.accent }};">{{ block.settings.title | escape }}</strong>
    <p style="margin:6px 0 0;">{{ block.settings.text | escape }}</p>
    <a href="/apps/perks/verify" style="display:inline-block; margin-top:8px; text-decoration:underline;">{{ block.settings.cta | escape }}</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Employee badge",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "text", "id": "title", "label": "Title", "default": "Employee exclusive" },
    { "type": "text", "id": "text", "label": "Text", "default": "Available to verified employees. Log in and verify your work email to buy." },
    { "type": "text", "id": "cta", "label": "Link text", "default": "Verify now" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#111111" }
  ]
}
{% endschema %}
