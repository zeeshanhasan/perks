{%- comment -%} Call to action pointing customers at the verification page. {%- endcomment -%}
<div class="perks-cta" style="padding:{{ block.settings.padding }}px 16px; text-align:{{ block.settings.align }};">
  {%- if block.settings.heading != blank -%}<h2 style="margin:0 0 8px;">{{ block.settings.heading | escape }}</h2>{%- endif -%}
  {%- if block.settings.text != blank -%}<p style="margin:0 0 12px;">{{ block.settings.text | escape }}</p>{%- endif -%}
  <a href="/apps/perks/verify" style="display:inline-block; padding:12px 18px; border-radius:6px; background:{{ block.settings.button_bg }}; color:{{ block.settings.button_fg }}; text-decoration:none;">
    {{ block.settings.button | escape }}
  </a>
</div>

{% schema %}
{
  "name": "Employee perks link",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Employee perks" },
    { "type": "text", "id": "text", "label": "Text", "default": "Work for one of our partners? Verify your work email for exclusive products and prices." },
    { "type": "text", "id": "button", "label": "Button", "default": "Verify my work email" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 64, "step": 4, "default": 24, "unit": "px" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#111111" },
    { "type": "color", "id": "button_fg", "label": "Button text", "default": "#ffffff" }
  ]
}
{% endschema %}
